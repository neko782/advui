{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json",
    "paths": {
      "$lib/*": [
        "../src/lib/*",
        "./svelte/src/lib/*"
      ]
    }
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte/svelte-html.d.ts"
  ],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.d.ts",
    "../src/**/*.svelte",
    "../vite.config.ts",
    "svelte/src/**/*.ts",
    "svelte/src/**/*.d.ts",
    "svelte/src/**/*.d.svelte.ts",
    "svelte/vite.config.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "svelte/node_modules",
    "svelte/dist",
    "../src/App.svelte",
    "../src/lib/Chat.svelte",
    "../src/lib/Icon.svelte",
    "../src/lib/SettingsModal.svelte",
    "../src/lib/components/ConfirmModal.svelte",
    "../src/lib/components/EditModal.svelte",
    "../src/lib/components/OpenRouterProviderInput.svelte",
    "../src/lib/components/Sidebar.svelte",
    "../src/lib/components/common/IconButton.svelte",
    "../src/lib/components/common/SendMenu.svelte",
    "../src/lib/components/chat/ChatSettingsPopover.svelte",
    "../src/lib/components/chat/Composer.svelte",
    "../src/lib/components/chat/MarkdownContent.svelte",
    "../src/lib/components/chat/MessageActions.svelte",
    "../src/lib/components/chat/MessageBubble.svelte",
    "../src/lib/components/chat/MessageItem.svelte",
    "../src/lib/components/chat/MessageList.svelte",
    "../src/lib/components/chat/MessageMeta.svelte",
    "../src/lib/components/settings/ConnectionsTab.svelte",
    "../src/lib/components/settings/FeaturesTab.svelte",
    "../src/lib/components/settings/GeneralTab.svelte",
    "../src/lib/components/settings/PresetsTab.svelte",
    "../src/lib/components/tavern/CharacterEditorModal.svelte",
    "../src/lib/components/tavern/TavernSettingsModal.svelte",
    "../src/lib/components/tavern/TavernSidebar.svelte",
    "../src/lib/components/chat/__fixtures__/ComposerHarness.svelte",
    "../src/lib/components/settings/__fixtures__/SettingsModalHarness.svelte"
  ]
}