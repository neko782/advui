{
  "name": "advui",
  "private": false,
  "version": "0.0.0",
  "description": "Advanced single-page chat UI built with Svelte and Vite.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git@github.com:neko782/advui.git"
  },
  "homepage": "https://github.com/neko782/advui",
  "bugs": {
    "url": "https://github.com/neko782/advui/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "deploy:pages": "bash ./scripts/deploy-pages.sh",
    "preview": "vite preview",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "verify": "bun run check && bun run test:run && bun run build"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.547",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@7",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tanstack/svelte-virtual": "^3.13.48",
    "highlight.js": "^11.12.0",
    "js-untar": "^2.0.0",
    "katex": "^0.19.1",
    "klona": "^2.0.6",
    "marked": "^18.1.1",
    "tar-js": "^0.3.0"
  }
}
